<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativo oscuro: carbon (CLODColors.carbon, #2B2B2E —
     scaffoldBackgroundColor de CLODTheme.dark, el tema por defecto de esta
     app) con el logo CLOD centrado. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fondo_oscuro" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
