<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativo claro: grisClaro (CLODColors.grisClaro, #F4F6F8 —
     scaffoldBackgroundColor de CLODTheme.light) con el logo CLOD centrado,
     sin ningún rastro del logo de Flutter. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fondo_claro" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
