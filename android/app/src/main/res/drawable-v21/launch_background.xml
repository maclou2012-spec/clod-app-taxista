<?xml version="1.0" encoding="utf-8"?>
<!-- Splash nativo claro (API 21+, el único rango real desde minSdk 21) —
     mismo contenido que drawable/launch_background.xml; ver ese archivo
     para el porqué del color y el logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_fondo_claro" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
